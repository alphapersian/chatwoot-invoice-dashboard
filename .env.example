# Required — set in Coolify → your app → Environment Variables
INVOICE_NINJA_URL=https://your-invoice-ninja.example.com
INVOICE_NINJA_API_TOKEN=your_api_token_here

# Optional — local dev only (docker-compose.local.yaml)
# APP_PORT=8080
# Run locally: docker compose -f docker-compose.local.yaml up --build

# Coolify deployment checklist:
# 1. New Resource → Application → Git repository
# 2. Build pack: Dockerfile
# 3. Port: 80
# 4. Health check path: /health.php
# 5. Enable HTTPS on your domain (required for Chatwoot dashboard apps)
# 6. Add the public URL in Chatwoot → Settings → Integrations → Dashboard apps
